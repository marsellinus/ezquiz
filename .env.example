# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/online_exam"

# Auth.js / NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Gemini API key for the AI question generator (optional — feature is disabled without it)
GEMINI_API_KEY=""

# Cloudflare Tunnel token (optional, only for the docker-compose cloudflared service)
CLOUDFLARE_API_TOKEN=""

# Media upload (default: ./public/uploads). Files are served via /api/uploads/<name>.
# In Docker/compose: UPLOAD_DIR="/app/uploads" (uploads_data volume).
UPLOAD_DIR="./public/uploads"
