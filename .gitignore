# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in to committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded media (served at runtime via /api/uploads, not part of the build)
/public/uploads/
/uploads/

/src/generated/prisma

# local-only artifacts (never part of the app)
/dev.db
install.log
*.mp4

# AI tool skill packs (generated locally by the Prisma skills installer)
.agents/
.claude/
.windsurf/
skills-lock.json
